{
  "templates": [
    {
      "name": "branding-card-test",
      "urls": [
        "https://www.plazapremiumlounge.com/en-uk/your-destination-before-departure"
      ],
      "description": "Branding Card test page (/en-uk/drafts/blocks/branding-card): the source's \"Your Destination Before Departure\" destination grid, plus cases for missing fields",
      "blocks": [
        {
          "name": "branding-card",
          "instances": [
            "section.branding .grid-wrapper"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Your Destination Before Departure",
          "selector": [
            "section.branding"
          ],
          "style": "fixed-width",
          "blocks": [
            "branding-card"
          ],
          "defaultContent": [
            "section.branding > .container > h2"
          ]
        }
      ]
    },
    {
      "name": "html-embed",
      "urls": [
        "https://www.plazapremiumlounge.com/en-uk/offers/beyond_the_event"
      ],
      "description": "Page whose body is authored HTML (Kentico Froala, .fr-view, with its own CSS and JS): the page title, then the HTML as-is in an Embed Code block",
      "blocks": [
        {
          "name": "title",
          "instances": [
            ".contentWrapper .title-wrapper"
          ]
        },
        {
          "name": "embed-code",
          "instances": [
            ".fr-view"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Page title",
          "selector": [
            ".contentWrapper .title-wrapper"
          ],
          "style": "inset",
          "blocks": [
            "title"
          ],
          "defaultContent": []
        },
        {
          "id": "section-2",
          "name": "Authored HTML",
          "selector": [
            ".fr-view"
          ],
          "style": null,
          "blocks": [
            "embed-code"
          ],
          "defaultContent": []
        }
      ]
    }
  ]
}
