{
  "templates": [
    {
      "name": "branding-card-test",
      "urls": [
        "https://www.plazapremiumlounge.com/en-uk/your-destination-before-departure"
      ],
      "description": "Branding Card test page (/en-uk/drafts/blocks/branding-card): the source's \"Your Destination Before Departure\" destination grid, plus cases for missing fields",
      "blocks": [
        {
          "name": "branding-card",
          "instances": [
            "section.branding .grid-wrapper"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Your Destination Before Departure",
          "selector": [
            "section.branding"
          ],
          "style": "fixed-width",
          "blocks": [
            "branding-card"
          ],
          "defaultContent": [
            "section.branding > .container > h2"
          ]
        }
      ]
    },
    {
      "name": "sign-up",
      "urls": [
        "https://www.plazapremiumlounge.com/en-uk/sign-up"
      ],
      "description": "Sign up page (/en-uk/sign-up): the page title and the sign up form as a Custom Form (two-columns)",
      "blocks": [
        {
          "name": "custom-form",
          "instances": [
            "#formBookingRegistration"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Sign Up",
          "selector": [
            "section.news"
          ],
          "style": null,
          "blocks": [
            "custom-form"
          ],
          "defaultContent": [
            "section.news .title-wrapper h2"
          ]
        }
      ]
    }
  ]
}
